{
  "__inputs": [ { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }, { "name": "DS_LOKI", "label": "Loki", "type": "datasource", "pluginId": "loki", "pluginName": "Loki" } ],
      "title": "Student App on Kubernetes",
      "uid": "student-app",
      "schemaVersion": 39,
      "refresh": "10s",
      "time": { "from": "now-30m", "to": "now" },
      "panels": [
        {
          "type": "stat", "title": "Web pods ready",
          "gridPos": { "h": 5, "w": 5, "x": 0, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"om\", deployment=\"web\"}" }],
          "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "orange", "value": 1 }, { "color": "green", "value": 3 } ] } }, "overrides": [] }
        },
        {
          "type": "stat", "title": "Database up",
          "gridPos": { "h": 5, "w": 5, "x": 5, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "expr": "pg_up" }],
          "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
          "fieldConfig": { "defaults": {
            "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }],
            "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
        },
        {
          "type": "stat", "title": "Students in table",
          "gridPos": { "h": 5, "w": 5, "x": 10, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "expr": "pg_stat_user_tables_n_live_tup{relname=\"students\"}" }],
          "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] }
        },
        {
          "type": "stat", "title": "Pod restarts (om)",
          "gridPos": { "h": 5, "w": 5, "x": 15, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"om\"})" }],
          "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] }
        },
        {
          "type": "stat", "title": "DB connections",
          "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "expr": "sum(pg_stat_database_numbackends{datname=\"portfolio_db\"})" }],
          "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
          "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] }
        },
        {
          "type": "timeseries", "title": "CPU per pod (cores)",
          "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "legendFormat": "{{pod}}",
            "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"om\", container!=\"\"}[2m]))" }],
          "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
        },
        {
          "type": "timeseries", "title": "Memory per pod",
          "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [{ "refId": "A", "legendFormat": "{{pod}}",
            "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"om\", container!=\"\"})" }],
          "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
        },
        {
          "type": "timeseries", "title": "Student rows changed (last 5 min)",
          "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "targets": [
            { "refId": "A", "legendFormat": "inserted", "expr": "increase(pg_stat_user_tables_n_tup_ins{relname=\"students\"}[5m])" },
            { "refId": "B", "legendFormat": "updated",  "expr": "increase(pg_stat_user_tables_n_tup_upd{relname=\"students\"}[5m])" },
            { "refId": "C", "legendFormat": "deleted",  "expr": "increase(pg_stat_user_tables_n_tup_del{relname=\"students\"}[5m])" }
          ],
          "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
        },
        {
          "type": "logs", "title": "Website logs (Loki)",
          "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 },
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "targets": [{ "refId": "A", "expr": "{namespace=\"om\", app=\"web\"}" }],
          "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
        },
        {
          "type": "logs", "title": "Database logs (Loki)",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "targets": [{ "refId": "A", "expr": "{namespace=\"om\", app=\"postgres\"}" }],
          "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
        }
      ]
    }